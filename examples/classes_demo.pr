/* OOP demo using closures and dicts */

func make_shape(color, area_fn, type_name_fn) {
    let self = {}
    self["color"] = color
    self["area"] = area_fn
    self["type_name"] = type_name_fn
    self["describe"] = func() {
        output(self["type_name"]() + " [" + self["color"] + "] area=" + str(round(self["area"](), 2)))
    }
    return self
}

func make_circle(color, radius) {
    return make_shape(color, func() { return PI * radius * radius }, func() { return "Circle" })
}

func make_rectangle(color, w, h) {
    return make_shape(color, func() { return w * h }, func() { return "Rectangle" })
}

func make_triangle(color, base, height) {
    return make_shape(color, func() { return 0.5 * base * height }, func() { return "Triangle" })
}

let shapes = [
    make_circle("red", 5),
    make_rectangle("blue", 4, 6),
    make_triangle("green", 3, 8),
    make_circle("purple", 2),
]

output("Shapes:")
for s in shapes {
    s["describe"]()
}

let total = 0
for s in shapes {
    total = total + s["area"]()
}
output("Total area: " + str(round(total, 2)))

let biggest = shapes[0]
for s in shapes {
    if s["area"]() > biggest["area"]() {
        biggest = s
    }
}
output("Biggest: " + biggest["type_name"]() + " with area " + str(round(biggest["area"](), 2)))

output("[PASS] examples/classes_demo")
