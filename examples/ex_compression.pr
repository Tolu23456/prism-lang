/* Compression and Encoding Examples */

import "lib/compression"

func exampleBase64() {
    output("\n=== Base64 Encoding ===")
    
    let text = "Hello, World!"
    let encoded = base64Encode(text)
    let decoded = base64Decode(encoded)
    
    output("Original: " + text)
    output("Encoded: " + encoded)
    output("Decoded: " + decoded)
    output("Match: " + str(text == decoded))
}

func exampleHex() {
    output("\n=== Hex Encoding ===")
    
    let text = "ABC"
    let hex = toHex(text)
    let back = fromHex(hex)
    
    output("Original: " + text)
    output("Hex: " + hex)
    output("Restored: " + back)
    output("Match: " + str(text == back))
}

func exampleURLEncoding() {
    output("\n=== URL Encoding ===")
    
    let text = "hello world & special=chars"
    let encoded = encodeUrl(text)
    let decoded = decodeUrl(encoded)
    
    output("Original: " + text)
    output("Encoded: " + encoded)
    output("Decoded: " + decoded)
    output("Match: " + str(text == decoded))
}

func exampleRLE() {
    output("\n=== Run-Length Encoding ===")
    
    let data = "AAAAAABBBBCCCD"
    let compressed = rleEncode(data)
    let decompressed = rleDecode(compressed)
    
    output("Original: " + data)
    output("Compressed: " + compressed)
    output("Decompressed: " + decompressed)
    output("Match: " + str(data == decompressed))
    
    let ratio = len(data) / len(compressed)
    output("Compression ratio: " + str(ratio) + "x")
}

func exampleLZ77() {
    output("\n=== LZ77 Compression ===")
    
    let data = "the quick brown fox jumps over the lazy dog the quick brown"
    let compressed = lz77Compress(data)
    let decompressed = lz77Decompress(compressed)
    
    output("Original length: " + str(len(data)))
    output("Compressed length: " + str(len(compressed)))
    output("Decompressed matches: " + str(data == decompressed))
    
    let savings = (len(data) - len(compressed)) * 100 / len(data)
    output("Space saved: " + str(savings) + "%")
}

func exampleCRC32() {
    output("\n=== CRC32 Checksums ===")
    
    let data = "important data that must not be corrupted"
    let checksum1 = crc32(data)
    let checksum2 = crc32(data)
    let checksum3 = crc32(data + "!")
    
    output("Data: " + data)
    output("Checksum: " + str(checksum1))
    output("Same data same checksum: " + str(checksum1 == checksum2))
    output("Modified data different checksum: " + str(checksum1 != checksum3))
}

func exampleMultipleEncodings() {
    output("\n=== Multiple Encoding Formats ===")
    
    let text = "Prism"
    
    let base64 = base64Encode(text)
    let hex = toHex(text)
    let url = encodeUrl(text)
    
    output("Text: " + text)
    output("Base64: " + base64)
    output("Hex: " + hex)
    output("URL: " + url)
}

func exampleDataIntegrity() {
    output("\n=== Data Integrity Check ===")
    
    let file = "database.pdb"
    let data = "database content here"
    
    # Create checksum
    let checksum = crc32(data)
    
    # Verify later
    let dataLater = "database content here"
    let checksumLater = crc32(dataLater)
    
    if checksum == checksumLater {
        output("✓ File " + file + " integrity verified")
    } else {
        output("✗ File " + file + " may be corrupted")
    }
}

func exampleCompression() {
    output("\n=== Compression Strategy ===")
    
    let text = "mississippi river"
    
    # Try both compression methods
    let rle = rleEncode(text)
    let lz77 = lz77Compress(text)
    
    output("Original: " + str(len(text)) + " bytes")
    output("RLE: " + str(len(rle)) + " bytes")
    output("LZ77: " + str(len(lz77)) + " bytes")
    
    if len(rle) < len(lz77) {
        output("Best: RLE")
    } else {
        output("Best: LZ77")
    }
}

func exampleSafeTransmission() {
    output("\n=== Safe Data Transmission ===")
    
    let password = "super_secret_password"
    let encoded = base64Encode(password)
    
    output("Sending over network: " + encoded)
    
    # Receive and decode
    let received = encoded
    let decoded = base64Decode(received)
    
    output("Received and decoded: " + decoded)
    output("Integrity: " + str(password == decoded))
}

# Run all examples
exampleBase64()
exampleHex()
exampleURLEncoding()
exampleRLE()
exampleLZ77()
exampleCRC32()
exampleMultipleEncodings()
exampleDataIntegrity()
exampleCompression()
exampleSafeTransmission()

output("\n=== All compression examples completed ===")
