output("=== Prism New Features Test ===")

output("--- Ranges ---")
let r = 1..5
output(r)

let r2 = 1..10 step 2
output(r2)

let range_sum = 0
for x in 1..3 {
    range_sum += x
}
assert_eq(range_sum, 6, "range 1..3 sum")

output("--- Repeat ---")
let count = 0
repeat 3 {
    count += 1
}
assert_eq(count, 3, "repeat 3")

let n = 0
repeat while n < 3 {
    n += 1
}
assert_eq(n, 3, "repeat while")

let m = 5
repeat until m == 0 {
    m -= 1
}
assert_eq(m, 0, "repeat until")

output("--- Try/Catch ---")
let caught = false
try {
    throw "something went wrong"
} catch err {
    caught = true
}
assert_eq(caught, true, "try/catch works")

output("--- Match ---")
let val = 2
let matched = ""
match val {
    when 1 { matched = "one" }
    when 2 { matched = "two" }
    when 3 { matched = "three" }
    else   { matched = "other" }
}
assert_eq(matched, "two", "match 2")

output("--- Null coalescing ---")
let x = null
let y = x ?? "default"
assert_eq(y, "default", "null coalescing null")

let z = "real"
let w = z ?? "fallback"
assert_eq(w, "real", "null coalescing non-null")

output("--- Is/is not ---")
let aa = 42
assert_eq(aa is int, true, "int is int")
assert_eq(aa is not str, true, "int is not str")
assert_eq("hello" is str, true, "string is str")

output("--- String methods ---")
let s = "Hello, World!"
assert_eq(s.contains("World"), true, "contains true")
assert_eq(s.contains("xyz"), false, "contains false")
assert_eq(s.before(","), "Hello", "before comma")
assert_eq(s.after(", "), "World!", "after comma-space")
assert_eq(s.reverse(), "!dlroW ,olleH", "reverse string")
let words = "foo bar baz".words()
assert_eq(len(words), 3, "words count")
assert_eq("  hello  ".strip(), "hello", "strip whitespace")

output("--- Array methods ---")
let arr = [3, 1, 2]
arr.sort()
assert_eq(arr[0], 1, "sort first")
arr.reverse()
assert_eq(arr[0], 3, "reverse first after sort")
assert_eq(arr.contains(2), true, "array contains true")
assert_eq(arr.contains(99), false, "array contains false")
assert_eq(arr.count(3), 1, "array count")
assert_eq(arr.index(2), 1, "array index")

output("--- Dict methods ---")
let d = {"a": 1, "b": 2}
assert_eq(d.has("a"), true, "dict has a")
assert_eq(d.has("c"), false, "dict has c false")
d.remove("b")
assert_eq(d.has("b"), false, "dict remove b")

output("=== All tests complete ===")
output("[PASS] examples/new_features")
