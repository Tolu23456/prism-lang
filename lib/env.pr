/* Prism Standard Library — env module
   Environment variables and configuration management.
   Get, set, check environment variables with defaults.
*/

/* Get environment variable with optional default */
func get(name, default_val) {
    let val = system_getenv(name)
    return val ?? default_val
}

/* Get required environment variable or raise error */
func require(name) {
    let val = get(name)
    if val == null {
        error("Environment variable '" + name + "' is required")
    }
    return val
}

/* Check if environment variable exists */
func has(name) {
    return system_getenv(name) != null
}

/* Get all environment variables as dict */
func all() {
    return system_getenv_all()
}

/* Set environment variable */
func set(name, value) {
    system_setenv(name, str(value))
}

/* Parse boolean from environment variable */
func bool(name, default_val) {
    let val = get(name, default_val)
    if type(val) == "boolean" { return val }
    if type(val) == "string" {
        return lower(val) == "true" or lower(val) == "1" or lower(val) == "yes"
    }
    return val
}

/* Parse integer from environment variable */
func int(name, default_val) {
    let val = get(name, default_val)
    if type(val) == "number" { return val }
    return parse_int(str(val), 10)
}

/* Parse float from environment variable */
func float(name, default_val) {
    let val = get(name, default_val)
    if type(val) == "number" { return val }
    return parse_float(str(val))
}

/* Get environment with namespace prefix */
func namespace(prefix) {
    let all_vars = all()
    let namespaced = {}
    for key in keys(all_vars) {
        if starts_with(key, prefix + "_") {
            let short_key = slice(key, len(prefix) + 1)
            namespaced[short_key] = all_vars[key]
        }
    }
    return namespaced
}

/* Check if running in development environment */
func is_dev() {
    return bool("NODE_ENV", false) == "development" or
           bool("PRISM_ENV", false) == "dev"
}

/* Check if running in production environment */
func is_prod() {
    return bool("NODE_ENV", false) == "production" or
           bool("PRISM_ENV", false) == "prod"
}

/* Check if running in test environment */
func is_test() {
    return bool("NODE_ENV", false) == "test" or
           bool("PRISM_ENV", false) == "test"
}
