/* Prism Standard Library — event module
   EventEmitter pattern inspired by Node.js EventEmitter.
   Closure-based OOP — compatible with the bytecode VM.

   Usage:
     import event
     let em = makeEmitter()
     em["on"]("click", fn(data) { output(data) })
     em["emit"]("click", "hello")
*/

func makeEmitter() {
    let _listeners = {}
    let _once_set  = {}

    func _getList(event) {
        if not has(_listeners, event) { return [] }
        return _listeners[event]
    }

    func on(event, handler) {
        if not has(_listeners, event) { _listeners[event] = [] }
        push(_listeners[event], handler)
        return null
    }

    func once(event, handler) {
        on(event, handler)
        if not has(_once_set, event) { _once_set[event] = [] }
        push(_once_set[event], handler)
        return null
    }

    func off(event, handler) {
        if not has(_listeners, event) { return null }
        let updated = []
        for h in _listeners[event] {
            if str(h) != str(handler) { push(updated, h) }
        }
        _listeners[event] = updated
        return null
    }

    func emit(event, data) {
        if not has(_listeners, event) { return null }
        let to_remove = has(_once_set, event) ? _once_set[event] : []
        let kept = []
        for handler in _listeners[event] {
            handler(data)
            let is_once = false
            for r in to_remove {
                if str(r) == str(handler) { is_once = true }
            }
            if not is_once { push(kept, handler) }
        }
        _listeners[event] = kept
        if has(_once_set, event) { _once_set[event] = [] }
        return null
    }

    func listeners(event) {
        return _getList(event)
    }

    func listenerCount(event) {
        return len(_getList(event))
    }

    func removeAll(event) {
        if event != null {
            _listeners[event] = []
            if has(_once_set, event) { _once_set[event] = [] }
        } else {
            _listeners = {}
            _once_set  = {}
        }
        return null
    }

    func eventNames() {
        return keys(_listeners)
    }

    return {
        "on":            on,
        "once":          once,
        "off":           off,
        "emit":          emit,
        "listeners":     listeners,
        "listenerCount": listenerCount,
        "removeAll":     removeAll,
        "eventNames":    eventNames,
    }
}
