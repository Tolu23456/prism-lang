/* Prism Standard Library — strings module
   Comprehensive string manipulation, Unicode-aware utilities, and formatting.

   UTF-8 API  (codepoint-based):
     utf8_len(s)              → int    — codepoint count (not byte count)
     utf8_byte_len(s)         → int    — byte count (same as builtin len())
     utf8_chars(s)            → array  — array of Unicode character strings
     utf8_codepoints(s)       → array  — array of integer codepoints
     utf8_slice(s, start, end)→ string — slice by codepoint index
     utf8_encode(codepoints)  → string — build string from codepoint array

   General string utilities (byte-indexed for ASCII; UTF-8 safe otherwise):
     capitalize(s)            titleCase(s)      camelCase(s)
     snakeCase(s)             kebabCase(s)      swapCase(s)
     padLeft(s, w, ch)        padRight(s, w, ch) padCenter(s, w, ch)
     repeat(s, n)
     isBlank(s)               isEmpty(s)
     countOccurrences(h, n)   indexOfChar(s, ch)  lastIndexOf(s, n)
     isNumeric(s)             isAlpha(s)          isAlphaNumeric(s)
     isUpperCase(s)           isLowerCase(s)      isPalindrome(s)
     startsWithAny(s, ps)     endsWithAny(s, ss)
     reverse(s)               truncate(s, max, e) stripLeft(s, ch)
     stripRight(s, ch)        strip(s, ch)        removeAll(s, t)
     replaceAll(s, f, t)      replaceFirst(s, f, t) insertAt(s, pos, t)
     deleteAt(s, s, e)        wrap(s, pre, suf)   unwrap(s, pre, suf)
     toBool(s)                toLines(s)          toWords(s)
     indent(s, sp)            dedent(s, sp)       slugify(s)
     template(tmpl, vars)     countWords(s)       commonPrefix(a, b)
     levenshtein(a, b)        similarity(a, b)    charFrequency(s)
     wrapWords(s, w)

   NOTE: chars() builtin now returns one element per Unicode codepoint.
   Byte-level len() and slice() are unchanged — use utf8_len() / utf8_slice()
   when you need character counts and positions for non-ASCII content.
*/

/* ── UTF-8 helpers (private) ─────────────────────────────────── */

/* Byte length of the UTF-8 character starting at byte offset i in s */
func _utf8_step(s, i) {
    let b = ord(slice(s, i, i + 1))
    if b >= 240 { return 4 }
    if b >= 224 { return 3 }
    if b >= 192 { return 2 }
    return 1
}

/* ── UTF-8 public API ────────────────────────────────────────── */

/* Number of Unicode codepoints in s (not byte count) */
func utf8_len(s) {
    let count = 0
    let i     = 0
    let n     = len(s)
    while i < n {
        i += _utf8_step(s, i)
        count += 1
    }
    return count
}

/* Byte count — same as builtin len(), provided for clarity */
func utf8_byte_len(s) { return len(s) }

/* Array of Unicode character strings (one element per codepoint).
   Equivalent to the builtin chars() — provided for explicit naming. */
func utf8_chars(s) { return chars(s) }

/* Array of integer codepoints */
func utf8_codepoints(s) {
    let result = []
    for c in chars(s) { push(result, ord(c)) }
    return result
}

/* Build a string from an array of integer codepoints */
func utf8_encode(codepoints) {
    let result = ""
    for cp in codepoints { result = result + chr(cp) }
    return result
}

/* Slice s by codepoint index [start, end).
   Supports negative indices (Python-style). end=null means "to end". */
func utf8_slice(s, start, end) {
    let n = len(s)
    /* Collect byte offsets of each codepoint boundary + one past the last */
    let offsets = [0]
    let i = 0
    while i < n {
        i += _utf8_step(s, i)
        push(offsets, i)
    }
    let total = len(offsets) - 1   /* codepoint count */
    if start == null { start = 0 }
    if end   == null { end   = total }
    if start < 0 { start = total + start }
    if end   < 0 { end   = total + end   }
    if start < 0 { start = 0 }
    if end > total { end = total }
    if start >= end { return "" }
    return slice(s, offsets[start], offsets[end])
}

/* ── Case & Formatting ───────────────────────────────────────── */

func capitalize(s) {
    if len(s) == 0 { return s }
    let first_char = chars(s)[0]
    return upper(first_char) + lower(slice(s, len(first_char)))
}

func titleCase(s) {
    let words  = split(s, " ")
    let result = []
    for w in words { push(result, capitalize(w)) }
    return join(" ", result)
}

func camelCase(s) {
    let parts = split(s, " ")
    if len(parts) == 0 { return s }
    let out = lower(parts[0])
    let i   = 1
    while i < len(parts) {
        out = out + capitalize(parts[i])
        i += 1
    }
    return out
}

func snakeCase(s) {
    let out = ""
    let chs = chars(s)
    for ch in chs {
        if ch == " " || ch == "-" {
            let n = len(out)
            if n > 0 && slice(out, n - 1) != "_" { out = out + "_" }
        } elif ch >= "A" && ch <= "Z" {
            let n = len(out)
            if n > 0 && slice(out, n - 1) != "_" { out = out + "_" }
            out = out + lower(ch)
        } else {
            out = out + ch
        }
    }
    return out
}

func kebabCase(s) {
    return replace(snakeCase(s), "_", "-")
}

func swapCase(s) {
    let out = ""
    for ch in chars(s) {
        if ch >= "A" && ch <= "Z" { out = out + lower(ch) }
        elif ch >= "a" && ch <= "z" { out = out + upper(ch) }
        else { out = out + ch }
    }
    return out
}

/* ── Padding & Alignment (Unicode-aware width) ───────────────── */

func padLeft(s, width, ch) {
    ch = ch ?? " "
    let out = str(s)
    while utf8_len(out) < width { out = ch + out }
    return out
}

func padRight(s, width, ch) {
    ch = ch ?? " "
    let out = str(s)
    while utf8_len(out) < width { out = out + ch }
    return out
}

func padCenter(s, width, ch) {
    ch = ch ?? " "
    let out       = str(s)
    let total_pad = width - utf8_len(out)
    if total_pad <= 0 { return out }
    let left_pad  = (total_pad + 1) // 2
    let right_pad = total_pad - left_pad
    return _repeat_string(ch, left_pad) + out + _repeat_string(ch, right_pad)
}

func _repeat_string(s, n) {
    let result = ""
    let i      = 0
    while i < n { result = result + s; i += 1 }
    return result
}

/* ── Search & Test ───────────────────────────────────────────── */

func isBlank(s) { return len(trim(s)) == 0 }
func isEmpty(s) { return len(s) == 0 }

func countOccurrences(haystack, needle) {
    if len(needle) == 0 { return 0 }
    let parts = split(haystack, needle)
    return len(parts) - 1
}

func indexOfChar(s, ch) {
    let i = 0
    while i < len(s) {
        if slice(s, i, i + 1) == ch { return i }
        i += 1
    }
    return -1
}

func lastIndexOf(s, needle) {
    let last = -1
    let i    = 0
    while i <= len(s) - len(needle) {
        if slice(s, i, i + len(needle)) == needle { last = i }
        i += 1
    }
    return last
}

func isNumeric(s) {
    let trimmed = trim(s)
    if len(trimmed) == 0 { return false }
    let dot_count = 0
    let start     = 0
    if slice(trimmed, 0, 1) == "-" { start = 1 }
    let i = start
    while i < len(trimmed) {
        let ch = slice(trimmed, i, i + 1)
        if ch == "." {
            dot_count += 1
            if dot_count > 1 { return false }
        } elif ch < "0" || ch > "9" {
            return false
        }
        i += 1
    }
    return len(trimmed) - start > 0
}

func isAlpha(s) {
    if len(s) == 0 { return false }
    for ch in chars(s) {
        if !((ch >= "A" && ch <= "Z") || (ch >= "a" && ch <= "z")) {
            return false
        }
    }
    return true
}

func isAlphaNumeric(s) {
    if len(s) == 0 { return false }
    for ch in chars(s) {
        let ok = (ch >= "A" && ch <= "Z") ||
                 (ch >= "a" && ch <= "z") ||
                 (ch >= "0" && ch <= "9")
        if !ok { return false }
    }
    return true
}

func isUpperCase(s) {
    if len(s) == 0 { return false }
    return upper(s) == s
}

func isLowerCase(s) {
    if len(s) == 0 { return false }
    return lower(s) == s
}

func isPalindrome(s) {
    let clean = lower(s)
    let rev   = reverse(clean)
    return clean == rev
}

func startsWithAny(s, prefixes) {
    for p in prefixes {
        if starts(s, p) { return true }
    }
    return false
}

func endsWithAny(s, suffixes) {
    for sx in suffixes {
        if ends(s, sx) { return true }
    }
    return false
}

/* ── Transform ───────────────────────────────────────────────── */

/* Reverse by Unicode codepoints (chars() is now UTF-8 aware) */
func reverse(s) {
    let chs = chars(s)
    let out = ""
    let i   = len(chs) - 1
    while i >= 0 {
        out = out + chs[i]
        i -= 1
    }
    return out
}

/* Truncate by codepoint count */
func truncate(s, maxLen, ellipsis) {
    ellipsis = ellipsis ?? "..."
    if utf8_len(s) <= maxLen { return s }
    return utf8_slice(s, 0, maxLen - utf8_len(ellipsis)) + ellipsis
}

func stripLeft(s, ch) {
    ch = ch ?? " "
    let i = 0
    while i < len(s) && slice(s, i, i + 1) == ch { i += 1 }
    return slice(s, i)
}

func stripRight(s, ch) {
    ch = ch ?? " "
    let i = len(s)
    while i > 0 && slice(s, i - 1, i) == ch { i -= 1 }
    return slice(s, 0, i)
}

func strip(s, ch) {
    return stripRight(stripLeft(s, ch), ch)
}

func removeAll(s, target) {
    return join("", split(s, target))
}

func replaceAll(s, from, to) {
    return join(to, split(s, from))
}

func replaceFirst(s, from, to) {
    let parts = split(s, from)
    if len(parts) < 2 { return s }
    let result = parts[0] + to
    let i = 1
    while i < len(parts) {
        if i > 1 { result = result + from }
        result = result + parts[i]
        i += 1
    }
    return result
}

func insertAt(s, pos, text) {
    return slice(s, 0, pos) + text + slice(s, pos)
}

func deleteAt(s, start, end) {
    return slice(s, 0, start) + slice(s, end)
}

func wrap(s, prefix, suffix) {
    suffix = suffix ?? prefix
    return prefix + s + suffix
}

func unwrap(s, prefix, suffix) {
    suffix = suffix ?? prefix
    if starts(s, prefix) && ends(s, suffix) {
        return slice(s, len(prefix), len(s) - len(suffix))
    }
    return s
}

/* ── Parsing & Conversion ────────────────────────────────────── */

func toBool(s) {
    let lo = lower(trim(s))
    if lo == "true"  || lo == "yes" || lo == "1" || lo == "on"  { return true  }
    if lo == "false" || lo == "no"  || lo == "0" || lo == "off" { return false }
    return null
}

func toLines(s) { return split(s, "\n") }
func toWords(s) { return split(trim(s), " ") }

func indent(s, spaces) {
    spaces = spaces ?? 4
    let pad   = _repeat_string(" ", spaces)
    let lines = toLines(s)
    let result = []
    for line in lines { push(result, pad + line) }
    return join("\n", result)
}

func dedent(s, spaces) {
    spaces = spaces ?? 4
    let lines  = toLines(s)
    let result = []
    for line in lines {
        let i = 0
        while i < spaces && i < len(line) && slice(line, i, i + 1) == " " {
            i += 1
        }
        push(result, slice(line, i))
    }
    return join("\n", result)
}

func slugify(s) {
    let out   = lower(s)
    out       = replaceAll(out, " ", "-")
    let clean = ""
    for ch in chars(out) {
        let ok = (ch >= "a" && ch <= "z") ||
                 (ch >= "0" && ch <= "9") ||
                 ch == "-"
        if ok { clean = clean + ch }
    }
    return strip(clean, "-")
}

func template(tmpl, vars) {
    let result = tmpl
    for k in keys(vars) {
        result = replaceAll(result, "{{" + k + "}}", str(vars[k]))
    }
    return result
}

func countWords(s) {
    let words = split(trim(s), " ")
    let count = 0
    for w in words {
        if len(trim(w)) > 0 { count += 1 }
    }
    return count
}

func commonPrefix(a, b) {
    let i = 0
    while i < len(a) && i < len(b) && slice(a, i, i + 1) == slice(b, i, i + 1) {
        i += 1
    }
    return slice(a, 0, i)
}

func levenshtein(a, b) {
    let m  = len(a)
    let n  = len(b)
    let dp = []
    let i  = 0
    while i <= m {
        let row = []
        let j   = 0
        while j <= n { push(row, 0); j += 1 }
        push(dp, row)
        i += 1
    }
    i = 0
    while i <= m { dp[i][0] = i; i += 1 }
    let j = 0
    while j <= n { dp[0][j] = j; j += 1 }
    i = 1
    while i <= m {
        j = 1
        while j <= n {
            let cost = 0
            if slice(a, i - 1, i) != slice(b, j - 1, j) { cost = 1 }
            let del = dp[i - 1][j] + 1
            let ins = dp[i][j - 1] + 1
            let sub = dp[i - 1][j - 1] + cost
            dp[i][j] = min(del, min(ins, sub))
            j += 1
        }
        i += 1
    }
    return dp[m][n]
}

func similarity(a, b) {
    let dist   = levenshtein(a, b)
    let maxLen = max(len(a), len(b))
    if maxLen == 0 { return 1.0 }
    return 1.0 - float(dist) / float(maxLen)
}

func charFrequency(s) {
    let freq = {}
    for ch in chars(s) {
        if has(freq, ch) { freq[ch] = freq[ch] + 1 }
        else              { freq[ch] = 1 }
    }
    return freq
}

func wrapWords(s, lineWidth) {
    let words   = toWords(s)
    let lines   = []
    let current = ""
    for w in words {
        if len(current) == 0 {
            current = w
        } elif len(current) + 1 + len(w) <= lineWidth {
            current = current + " " + w
        } else {
            push(lines, current)
            current = w
        }
    }
    if len(current) > 0 { push(lines, current) }
    return join("\n", lines)
}
