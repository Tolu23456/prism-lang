/* Prism Standard Library — xgui_advanced module
   Advanced GUI widgets and layout system for Prism xgui.
   Includes 20+ new widgets, responsive layouts, theming, animations.
*/

import "lib/gui"

/* ── Data Grid Widget ──────────────────────────────────────── */
class DataGrid {
    func init(rows, cols) {
        this.rows = rows
        this.cols = cols
        this.data = []
        this.selected_cell = null
        this.column_widths = []
    }
    
    func add_row(row_data) {
        push(this.data, row_data)
    }
    
    func render() {
        gui_data_grid_begin(this.rows, this.cols)
        
        for row in this.data {
            for cell in row {
                gui_data_grid_cell(str(cell))
            }
        }
        
        gui_data_grid_end()
    }
    
    func set_column_width(col_idx, width) {
        while len(this.column_widths) <= col_idx {
            push(this.column_widths, 100)
        }
        this.column_widths[col_idx] = width
    }
}

/* ── Tree View Widget ──────────────────────────────────────── */
class TreeNode {
    func init(label) {
        this.label = label
        this.expanded = false
        this.children = []
        this.value = null
    }
    
    func add_child(child_node) {
        push(this.children, child_node)
    }
    
    func render(depth) {
        if gui_tree_node(this.label, depth) {
            for child in this.children {
                child.render(depth + 1)
            }
        }
    }
}

class TreeView {
    func init(root_label) {
        this.root = TreeNode(root_label)
        this.selected_node = null
    }
    
    func add_root_child(label) {
        let node = TreeNode(label)
        this.root.add_child(node)
        return node
    }
    
    func render() {
        gui_tree_view_begin(this.root.label)
        for child in this.root.children {
            child.render(0)
        }
        gui_tree_view_end()
    }
}

/* ── Table Widget ──────────────────────────────────────────── */
class Table {
    func init(headers) {
        this.headers = headers
        this.rows = []
        this.selected_row = -1
    }
    
    func add_row(row_data) {
        push(this.rows, row_data)
    }
    
    func render() {
        gui_table_begin(this.headers, len(this.headers))
        
        for row in this.rows {
            gui_table_row(row, len(this.headers))
        }
        
        gui_table_end()
    }
}

/* ── Menu System ───────────────────────────────────────────── */
class Menu {
    func init() {
        this.items = []
        this.submenus = {}
    }
    
    func add_item(label, callback) {
        push(this.items, {label: label, callback: callback})
    }
    
    func add_submenu(label) {
        let submenu = Menu()
        this.submenus[label] = submenu
        return submenu
    }
    
    func render() {
        gui_menu_bar_begin()
        
        for item in this.items {
            if gui_menu_item(item.label) {
                if item.callback {
                    item.callback()
                }
            }
        }
        
        gui_menu_bar_end()
    }
}

/* ── Color Picker Widget ──────────────────────────────────── */
class ColorPicker {
    func init(id, initial_color) {
        this.id = id
        this.current_color = initial_color ?? 0xFFFFFF
        this.show_picker = false
    }
    
    func render() {
        this.current_color = gui_color_picker(this.id, this.current_color)
        return this.current_color
    }
    
    func get_hex() {
        let hex = "0123456789ABCDEF"
        let r = (this.current_color >> 16) & 0xFF
        let g = (this.current_color >> 8) & 0xFF
        let b = this.current_color & 0xFF
        return "#" + hex[r // 16] + hex[r % 16] + hex[g // 16] + hex[g % 16] + hex[b // 16] + hex[b % 16]
    }
}

/* ── Responsive Grid Layout ────────────────────────────────── */
class ResponsiveGrid {
    func init(min_cols, max_cols) {
        this.min_cols = min_cols
        this.max_cols = max_cols
        this.items = []
    }
    
    func add_item(content) {
        push(this.items, content)
    }
    
    func render() {
        gui_responsive_grid_begin(this.min_cols, this.max_cols)
        for item in this.items {
            gui_responsive_grid_end()
        }
        gui_responsive_grid_end()
    }
}

/* ── Modal Dialog ────────────────────────────────────────── */
class Modal {
    func init(title) {
        this.title = title
        this.visible = false
        this.content = ""
        this.buttons = []
    }
    
    func show() {
        this.visible = true
    }
    
    func hide() {
        this.visible = false
    }
    
    func set_content(content) {
        this.content = content
    }
    
    func add_button(label, callback) {
        push(this.buttons, {label: label, callback: callback})
    }
    
    func render() {
        if this.visible {
            gui_modal_begin(this.title)
            gui_label(this.content)
            
            for btn in this.buttons {
                if gui_button(btn.label) {
                    if btn.callback {
                        btn.callback()
                    }
                    this.hide()
                }
            }
            
            if gui_modal_close_button() {
                this.hide()
            }
            
            gui_modal_end()
        }
    }
}

/* ── Theme System ──────────────────────────────────────────── */
class Theme {
    func init(name) {
        this.name = name
        this.colors = {}
        this.fonts = {}
        this.spacing = {}
    }
    
    func set_color(name, color) {
        this.colors[name] = color
    }
    
    func get_color(name) {
        return this.colors[name]
    }
    
    func apply() {
        gui_set_theme(this.name)
    }
}

/* ── Animation Controller ──────────────────────────────────── */
class AnimationController {
    func init() {
        this.animations = []
    }
    
    func add_value_animation(value, target, speed) {
        push(this.animations, {type: "value", ref: value, target: target, speed: speed})
    }
    
    func add_color_animation(color, target, speed) {
        push(this.animations, {type: "color", ref: color, target: target, speed: speed})
    }
    
    func update() {
        for anim in this.animations {
            if anim.type == "value" {
                gui_animate_value(anim.ref, anim.target, anim.speed)
            }
        }
    }
}

/* ── Touch Gesture Handler ──────────────────────────────── */
class GestureHandler {
    func init() {
        this.on_swipe_left = null
        this.on_swipe_right = null
        this.on_swipe_up = null
        this.on_swipe_down = null
        this.on_pinch = null
    }
    
    func handle_gestures() {
        if gui_swipe_left() and this.on_swipe_left {
            this.on_swipe_left()
        }
        if gui_swipe_right() and this.on_swipe_right {
            this.on_swipe_right()
        }
        if gui_swipe_up() and this.on_swipe_up {
            this.on_swipe_up()
        }
        if gui_swipe_down() and this.on_swipe_down {
            this.on_swipe_down()
        }
    }
}
