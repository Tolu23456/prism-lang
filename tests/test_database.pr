/* Comprehensive tests for Database library */

import "lib/database"
import "lib/testing"

describe("PrismaDB CRUD", fn() {
    test("insert and retrieve", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT)")
        
        let id = db.insert("users", {name: "Alice"})
        let user = db.selectOne("users", {id: id})
        
        assertEqual(user.name, "Alice")
    })
    
    test("update record", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT)")
        
        let id = db.insert("users", {name: "Bob"})
        db.update("users", {id: id}, {name: "Robert"})
        
        let user = db.selectOne("users", {id: id})
        assertEqual(user.name, "Robert")
    })
    
    test("delete record", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT)")
        
        let id = db.insert("users", {name: "Charlie"})
        db.delete("users", {id: id})
        
        let user = db.selectOne("users", {id: id})
        assertTrue(user == null)
    })
    
    test("select all", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE items (id INTEGER PRIMARY KEY, name TEXT)")
        
        db.insert("items", {name: "Item1"})
        db.insert("items", {name: "Item2"})
        db.insert("items", {name: "Item3"})
        
        let all = db.select("items")
        assertEqual(len(all), 3)
    })
    
    test("count records", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE data (id INTEGER PRIMARY KEY, value INTEGER)")
        
        for i in range(1, 6) {
            db.insert("data", {value: i})
        }
        
        let count = db.count("data")
        assertEqual(count, 5)
    })
})

describe("Query operators", fn() {
    test("equality operator", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE nums (id INTEGER PRIMARY KEY, value INTEGER)")
        
        db.insert("nums", {value: 10})
        db.insert("nums", {value: 20})
        db.insert("nums", {value: 10})
        
        let result = db.select("nums", {value: 10})
        assertEqual(len(result), 2)
    })
    
    test("greater than operator", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE nums (id INTEGER PRIMARY KEY, value INTEGER)")
        
        db.insert("nums", {value: 10})
        db.insert("nums", {value: 20})
        db.insert("nums", {value: 30})
        
        let result = db.select("nums", {value: {$gt: 15}})
        assertTrue(len(result) >= 2)
    })
    
    test("less than operator", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE nums (id INTEGER PRIMARY KEY, value INTEGER)")
        
        db.insert("nums", {value: 5})
        db.insert("nums", {value: 10})
        db.insert("nums", {value: 15})
        
        let result = db.select("nums", {value: {$lt: 12}})
        assertTrue(len(result) >= 2)
    })
    
    test("range query", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE nums (id INTEGER PRIMARY KEY, value INTEGER)")
        
        for i in range(1, 101) {
            db.insert("nums", {value: i})
        }
        
        let result = db.select("nums", {value: {$gte: 40, $lte: 60}})
        assertEqual(len(result), 21)
    })
})

describe("Transactions", fn() {
    test("successful transaction", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE accounts (id INTEGER PRIMARY KEY, balance INTEGER)")
        
        let acc1 = db.insert("accounts", {balance: 100})
        let acc2 = db.insert("accounts", {balance: 50})
        
        db.transaction(fn() {
            db.update("accounts", {id: acc1}, {balance: 80})
            db.update("accounts", {id: acc2}, {balance: 70})
        })
        
        let a1 = db.selectOne("accounts", {id: acc1})
        let a2 = db.selectOne("accounts", {id: acc2})
        
        assertEqual(a1.balance, 80)
        assertEqual(a2.balance, 70)
    })
    
    test("multiple operations in transaction", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE t (id INTEGER PRIMARY KEY, value INTEGER)")
        
        db.transaction(fn() {
            for i in range(1, 6) {
                db.insert("t", {value: i})
            }
        })
        
        let count = db.count("t")
        assertEqual(count, 5)
    })
})

describe("Indexing", fn() {
    test("index creation", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE users (id INTEGER PRIMARY KEY, email TEXT)")
        
        db.createIndex("users", "email", {unique: true})
        let indexes = db.getIndexes("users")
        
        assertTrue(len(indexes) >= 1)
    })
    
    test("unique index constraint", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE users (id INTEGER PRIMARY KEY, email TEXT)")
        
        db.createIndex("users", "email", {unique: true})
        
        db.insert("users", {email: "alice@example.com"})
        // Second insert with same email should fail or be handled
        assertTrue(true)
    })
})

describe("Backup and export", fn() {
    test("export data", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE data (id INTEGER PRIMARY KEY, value TEXT)")
        db.insert("data", {value: "test"})
        
        let exported = db.export()
        assertTrue(exported != null)
        assertTrue(len(exported) > 0)
    })
    
    test("import data", fn() {
        let db1 = PrismaDB(":memory:")
        db1.exec("CREATE TABLE data (id INTEGER PRIMARY KEY, value TEXT)")
        db1.insert("data", {value: "important"})
        
        let exported = db1.export()
        
        let db2 = PrismaDB(":memory:")
        db2.import(exported)
        
        let imported = db2.select("data")
        assertTrue(len(imported) > 0)
    })
})

describe("Data types", fn() {
    test("integer values", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE nums (id INTEGER PRIMARY KEY, value INTEGER)")
        
        db.insert("nums", {value: 42})
        db.insert("nums", {value: -100})
        db.insert("nums", {value: 0})
        
        let all = db.select("nums")
        assertEqual(len(all), 3)
    })
    
    test("text values", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE texts (id INTEGER PRIMARY KEY, value TEXT)")
        
        db.insert("texts", {value: "hello"})
        db.insert("texts", {value: "world"})
        db.insert("texts", {value: ""})
        
        let all = db.select("texts")
        assertEqual(len(all), 3)
    })
    
    test("null values", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE nullable (id INTEGER PRIMARY KEY, value TEXT)")
        
        db.insert("nullable", {value: null})
        let record = db.selectOne("nullable", {id: 1})
        
        assertTrue(record.value == null or record.value == "null")
    })
})

describe("Edge cases", fn() {
    test("empty table select", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE empty (id INTEGER PRIMARY KEY, value TEXT)")
        
        let result = db.select("empty")
        assertEqual(len(result), 0)
    })
    
    test("non-existent record", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT)")
        
        let user = db.selectOne("users", {id: 9999})
        assertTrue(user == null)
    })
    
    test("update non-existent", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT)")
        
        // Should not crash
        db.update("users", {id: 9999}, {name: "Ghost"})
        assertTrue(true)
    })
    
    test("delete non-existent", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT)")
        
        // Should not crash
        db.delete("users", {id: 9999})
        assertTrue(true)
    })
    
    test("special characters in values", fn() {
        let db = PrismaDB(":memory:")
        db.exec("CREATE TABLE data (id INTEGER PRIMARY KEY, value TEXT)")
        
        let special = "!@#$%^&*()[]{}\"'\n\t"
        db.insert("data", {value: special})
        
        let record = db.selectOne("data", {id: 1})
        assertEqual(record.value, special)
    })
})

output("Database test suite completed")
