/* Edge case tests for lib/fmt module */

import "lib/fmt"

let pass = 0
let fail = 0

func assert(label, got, expected) {
    if str(got) == str(expected) {
        pass += 1
    } else {
        output("FAIL:", label, "  got:", got, "expected:", expected)
        fail += 1
    }
}

func assert_near(label, got, expected, tol) {
    let diff = got - expected
    if diff < 0 { diff = -diff }
    if diff <= tol { pass += 1 }
    else { output("FAIL:", label, " got:", got, "expected~", expected); fail += 1 }
}

/* ── fmtInt ────────────────────────────────────────────────── */
assert("fmtInt(0)",          fmtInt(0, null),           "0")
assert("fmtInt(1)",          fmtInt(1, null),           "1")
assert("fmtInt(999)",        fmtInt(999, null),         "999")
assert("fmtInt(1000)",       fmtInt(1000, null),        "1,000")
assert("fmtInt(9999)",       fmtInt(9999, null),        "9,999")
assert("fmtInt(10000)",      fmtInt(10000, null),       "10,000")
assert("fmtInt(100000)",     fmtInt(100000, null),      "100,000")
assert("fmtInt(1000000)",    fmtInt(1000000, null),     "1,000,000")
assert("fmtInt(1234567)",    fmtInt(1234567, null),     "1,234,567")
assert("fmtInt(-1)",         fmtInt(-1, null),          "-1")
assert("fmtInt(-9876543)",   fmtInt(-9876543, null),    "-9,876,543")
assert("fmtInt(sep=.)",      fmtInt(1234567, "."),      "1.234.567")
assert("fmtInt(sep=space)",  fmtInt(1234567, " "),      "1 234 567")
assert("fmtInt(sep=empty)",  fmtInt(1234567, ""),       "1234567")

/* ── fmtFloat ──────────────────────────────────────────────── */
assert("fmtFloat(0)",          fmtFloat(0.0, 2, null),       "0.00")
assert("fmtFloat(0 dec=0)",    fmtFloat(0.0, 0, null),       "0")
assert("fmtFloat(1.5 dec=0)",  fmtFloat(1.5, 0, null),       "2")
assert("fmtFloat(1.4 dec=0)",  fmtFloat(1.4, 0, null),       "1")
assert("fmtFloat(1234.57)",    fmtFloat(1234.5678, 2, null), "1,234.57")
assert("fmtFloat(neg)",        fmtFloat(-99.9, 1, null),     "-99.9")
assert("fmtFloat(dec=3)",      fmtFloat(1.5, 3, null),       "1.500")
assert("fmtFloat(leading dec)",fmtFloat(0.05, 2, null),      "0.05")
assert("fmtFloat(no sep)",     fmtFloat(12345.6, 1, ""),     "12345.6")
assert("fmtFloat(small)",      fmtFloat(0.001, 3, null),     "0.001")

/* ── fmtBytes ──────────────────────────────────────────────── */
assert("fmtBytes(0)",         fmtBytes(0),          "0 B")
assert("fmtBytes(1)",         fmtBytes(1),          "1 B")
assert("fmtBytes(1023)",      fmtBytes(1023),       "1023 B")
assert("fmtBytes(1024)",      fmtBytes(1024),       "1.00 KB")
assert("fmtBytes(1536)",      fmtBytes(1536),       "1.50 KB")
assert("fmtBytes(1MB)",       fmtBytes(1048576),    "1.00 MB")
assert("fmtBytes(1GB)",       fmtBytes(1073741824), "1.00 GB")
assert("fmtBytes(neg)",       fmtBytes(-512),       "-512 B")

/* ── fmtDuration ───────────────────────────────────────────── */
assert("fmtDuration(0)",    fmtDuration(0),     "0s")
assert("fmtDuration(1)",    fmtDuration(1),     "1s")
assert("fmtDuration(59)",   fmtDuration(59),    "59s")
assert("fmtDuration(60)",   fmtDuration(60),    "1m")
assert("fmtDuration(61)",   fmtDuration(61),    "1m 1s")
assert("fmtDuration(3600)", fmtDuration(3600),  "1h")
assert("fmtDuration(3661)", fmtDuration(3661),  "1h 1m 1s")
assert("fmtDuration(1day)", fmtDuration(86400), "1d")
assert("fmtDuration(compound)", fmtDuration(90061), "1d 1h 1m 1s")
assert("fmtDuration(float)", fmtDuration(1.9),  "1s")

/* ── fmtPercent ────────────────────────────────────────────── */
assert("fmtPercent(3/4)",   fmtPercent(3, 4, null),    "75.0%")
assert("fmtPercent(1/3)",   fmtPercent(1, 3, 2),       "33.33%")
assert("fmtPercent(0)",     fmtPercent(0, 100, null),  "0.0%")
assert("fmtPercent(100)",   fmtPercent(100, 100, null),"100.0%")
assert("fmtPercent(/0)",    fmtPercent(5, 0, null),    "0%")

/* ── fmtOrdinal ────────────────────────────────────────────── */
assert("fmtOrdinal(1)",  fmtOrdinal(1),  "1st")
assert("fmtOrdinal(2)",  fmtOrdinal(2),  "2nd")
assert("fmtOrdinal(3)",  fmtOrdinal(3),  "3rd")
assert("fmtOrdinal(4)",  fmtOrdinal(4),  "4th")
assert("fmtOrdinal(10)", fmtOrdinal(10), "10th")
assert("fmtOrdinal(11)", fmtOrdinal(11), "11th")
assert("fmtOrdinal(12)", fmtOrdinal(12), "12th")
assert("fmtOrdinal(13)", fmtOrdinal(13), "13th")
assert("fmtOrdinal(21)", fmtOrdinal(21), "21st")
assert("fmtOrdinal(22)", fmtOrdinal(22), "22nd")
assert("fmtOrdinal(23)", fmtOrdinal(23), "23rd")
assert("fmtOrdinal(100)",fmtOrdinal(100),"100th")
assert("fmtOrdinal(101)",fmtOrdinal(101),"101st")
assert("fmtOrdinal(111)",fmtOrdinal(111),"111th")
assert("fmtOrdinal(0)",  fmtOrdinal(0),  "0th")

/* ── fmtPlural ─────────────────────────────────────────────── */
assert("fmtPlural(1)",   fmtPlural(1, "item", null),       "1 item")
assert("fmtPlural(0)",   fmtPlural(0, "item", null),       "0 items")
assert("fmtPlural(2)",   fmtPlural(2, "item", null),       "2 items")
assert("fmtPlural(1 custom)", fmtPlural(1, "ox", "oxen"), "1 ox")
assert("fmtPlural(3 custom)", fmtPlural(3, "ox", "oxen"), "3 oxen")

/* ── Text alignment ────────────────────────────────────────── */
assert("fmtPadLeft(6)",    fmtPadLeft("42", 6, null),   "    42")
assert("fmtPadLeft(0)",    fmtPadLeft("hello", 3, null),"hello")
assert("fmtPadLeft(ch=0)", fmtPadLeft("7", 4, "0"),     "0007")
assert("fmtPadRight(6)",   fmtPadRight("hi", 6, null),  "hi    ")
assert("fmtPadRight(ch=-)",fmtPadRight("hi", 6, "-"),   "hi----")
assert("fmtPadCenter(8)",  fmtPadCenter("OK", 8, null), "   OK   ")
assert("fmtPadCenter(*8)", fmtPadCenter("OK", 8, "*"),  "***OK***")
assert("fmtPadCenter(odd)",fmtPadCenter("X", 4, "-"),   "-X--")
assert("fmtPadCenter(exact)",fmtPadCenter("abc", 3, null),"abc")

/* ── fmtTruncate ───────────────────────────────────────────── */
assert("fmtTruncate(fit)",  fmtTruncate("Hello", 10, null),   "Hello")
assert("fmtTruncate(exact)",fmtTruncate("Hello", 5, null),    "Hello")
assert("fmtTruncate(cut)",  fmtTruncate("Hello World", 8, null),"Hello...")
assert("fmtTruncate(custom)",fmtTruncate("Long text", 7, "…"), "Long…")
assert("fmtTruncate(tiny)", fmtTruncate("Hi", 1, null),       ".")

/* ── fmtRepeat ─────────────────────────────────────────────── */
assert("fmtRepeat(0)",  fmtRepeat("abc", 0), "")
assert("fmtRepeat(1)",  fmtRepeat("ab", 1),  "ab")
assert("fmtRepeat(3)",  fmtRepeat("ab", 3),  "ababab")
assert("fmtRepeat(-)",  fmtRepeat("-", 5),   "-----")

/* ── fmtProgressBar ────────────────────────────────────────── */
assert("fmtProgress(0%)",  fmtProgressBar(0, 10, 10, "#", "-"),  "[----------] 0%")
assert("fmtProgress(50%)", fmtProgressBar(5, 10, 10, "#", "-"),  "[#####-----] 50%")
assert("fmtProgress(100%)",fmtProgressBar(10, 10, 10, "#", "-"), "[##########] 100%")
assert("fmtProgress(over)",fmtProgressBar(15, 10, 10, "#", "-"), "[##########] 100%")
assert("fmtProgress(neg)", fmtProgressBar(-5, 10, 10, "#", "-"), "[----------] 0%")

/* ── fmtTable ──────────────────────────────────────────────── */
let tbl1 = fmtTable(["A", "B"], [["x", "y"], ["long", "s"]])
assert("fmtTable contains header", contains(tbl1, "| A    | B |"), true)
assert("fmtTable contains data",   contains(tbl1, "| long | s |"), true)
assert("fmtTable empty rows", fmtTable(["X"], []),
       "+---+\n| X |\n+---+\n+---+")
assert("fmtTable no headers", fmtTable([], [["a"]]), "")

output("Results:", str(pass), "passed,", str(fail), "failed")
if fail == 0 { output("[PASS] test_fmt") }
else         { output("[FAIL] test_fmt") }
