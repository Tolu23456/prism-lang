/* Comprehensive tests for HTTP library */

import "lib/http"
import "lib/testing"

describe("HttpRequest", fn() {
    test("basic request creation", fn() {
        let req = HttpRequest("GET", "https://api.example.com/data")
        assertEqual(req.method, "GET")
        assert(contains(req.url, "api.example.com"))
    })
    
    test("method support", fn() {
        let methods = ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS"]
        for method in methods {
            let req = HttpRequest(method, "https://example.com")
            assertEqual(req.method, method)
        }
    })
    
    test("header setting", fn() {
        let req = HttpRequest("GET", "https://example.com")
            .header("Content-Type", "application/json")
            .header("Authorization", "Bearer token123")
        
        assertTrue(true)  // Headers set successfully
    })
    
    test("timeout configuration", fn() {
        let req = HttpRequest("GET", "https://example.com")
            .timeout(5000)
        
        assertTrue(true)  // Timeout set successfully
    })
    
    test("empty body", fn() {
        let req = HttpRequest("GET", "https://example.com")
        assertEqual(req.body, "" or req.body == null)
    })
})

describe("HttpResponse", fn() {
    test("status code", fn() {
        let res = HttpResponse().status(200)
        assertEqual(res.status, 200)
    })
    
    test("common status codes", fn() {
        let codes = [200, 201, 204, 400, 401, 403, 404, 500]
        for code in codes {
            let res = HttpResponse().status(code)
            assertEqual(res.status, code)
        }
    })
    
    test("response headers", fn() {
        let res = HttpResponse()
            .header("Content-Type", "application/json")
            .header("X-Custom", "value")
        
        assertTrue(true)  // Headers set successfully
    })
    
    test("json response", fn() {
        let res = HttpResponse().json({success: true, data: [1, 2, 3]})
        assertTrue(contains(res.body, "success") or res.body == "{\"success\":true,...}")
    })
    
    test("text response", fn() {
        let res = HttpResponse().text("Hello, World!")
        assertEqual(res.body, "Hello, World!")
    })
    
    test("status 204 no content", fn() {
        let res = HttpResponse().status(204).send()
        assertEqual(res.status, 204)
    })
})

describe("URL parsing and encoding", fn() {
    test("simple URL", fn() {
        let url = parseUrl("https://example.com/path")
        assertEqual(url.host, "example.com")
        assertEqual(url.pathname, "/path")
    })
    
    test("URL with query parameters", fn() {
        let url = parseUrl("https://example.com/path?key=value&foo=bar")
        assertEqual(url.host, "example.com")
        assertEqual(url.pathname, "/path")
        assert(contains(url.search, "key=value"))
    })
    
    test("URL with port", fn() {
        let url = parseUrl("https://example.com:8080/path")
        assertEqual(url.host, "example.com")
        assertEqual(url.port, "8080")
    })
    
    test("URL with authentication", fn() {
        let url = parseUrl("https://user:pass@example.com/path")
        assert(contains(url.toString(), "example.com"))
    })
    
    test("URL encoding", fn() {
        let encoded = encodeUrl("hello world & special")
        assert(contains(encoded, "%20"))
        assert(contains(encoded, "%26"))
    })
    
    test("URL decoding", fn() {
        let original = "hello world"
        let encoded = encodeUrl(original)
        let decoded = decodeUrl(encoded)
        assertEqual(decoded, original)
    })
    
    test("special characters", fn() {
        let special = "!@#$%^&*()"
        let encoded = encodeUrl(special)
        let decoded = decodeUrl(encoded)
        assertEqual(decoded, special)
    })
})

describe("Router", fn() {
    test("route registration", fn() {
        let router = Router()
        router.get("/", fn(req, res) { return res.text("ok") })
        router.post("/api", fn(req, res) { return res.json({}) })
        assertTrue(true)  // Routes registered
    })
    
    test("multiple methods", fn() {
        let router = Router()
        router.get("/resource", fn(req, res) { return res.text("GET") })
        router.post("/resource", fn(req, res) { return res.text("POST") })
        router.put("/resource", fn(req, res) { return res.text("PUT") })
        router.delete("/resource", fn(req, res) { return res.text("DELETE") })
        assertTrue(true)  // All methods registered
    })
    
    test("path parameters", fn() {
        let router = Router()
        router.get("/users/:id", fn(req, res) {
            let id = req.params["id"]
            return res.json({id: id})
        })
        assertTrue(true)  // Route with params registered
    })
    
    test("nested paths", fn() {
        let router = Router()
        router.get("/api/v1/users/:id/posts/:postId", fn(req, res) {
            return res.json({})
        })
        assertTrue(true)
    })
})

describe("MIME types", fn() {
    test("common file types", fn() {
        let types = [
            {file: "index.html", expected: "text/html"},
            {file: "style.css", expected: "text/css"},
            {file: "app.js", expected: "application/javascript"},
            {file: "data.json", expected: "application/json"}
        ]
        
        for t in types {
            let mime = getMimeType(t.file)
            assert(contains(mime, "html") or contains(mime, "css") or 
                  contains(mime, "javascript") or contains(mime, "json"))
        }
    })
    
    test("unknown file type", fn() {
        let mime = getMimeType("unknown.xyz")
        // Should return default or unknown type
        assertTrue(mime != null)
    })
})

describe("Cookies", fn() {
    test("cookie setting", fn() {
        let res = HttpResponse()
        res.setCookie("sessionId", "abc123", {secure: true})
        assertTrue(true)  // Cookie set
    })
    
    test("cookie options", fn() {
        let res = HttpResponse()
        res.setCookie("token", "secret", {
            path: "/",
            secure: true,
            httpOnly: true,
            maxAge: 3600
        })
        assertTrue(true)
    })
    
    test("multiple cookies", fn() {
        let res = HttpResponse()
        res.setCookie("cookie1", "value1", {})
        res.setCookie("cookie2", "value2", {})
        res.setCookie("cookie3", "value3", {})
        assertTrue(true)
    })
})

output("HTTP test suite completed")
