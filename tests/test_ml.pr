/* Comprehensive tests for ML library */

import "lib/ml"
import "lib/testing"

describe("Statistics", fn() {
    test("mean calculation", fn() {
        let data = [1, 2, 3, 4, 5]
        let m = mean(data)
        assertEqual(m, 3.0)
    })
    
    test("median of odd count", fn() {
        let data = [1, 3, 2, 5, 4]
        let med = median(data)
        assertEqual(med, 3)
    })
    
    test("median of even count", fn() {
        let data = [1, 2, 3, 4]
        let med = median(data)
        assertTrue(med == 2.5 or med == 2 or med == 3)
    })
    
    test("mode single", fn() {
        let data = [1, 2, 2, 3]
        let m = mode(data)
        assertEqual(m, 2)
    })
    
    test("mode no repeats", fn() {
        let data = [1, 2, 3, 4]
        let m = mode(data)
        assertTrue(m == null or m >= 1)
    })
    
    test("stddev calculation", fn() {
        let data = [1, 2, 3, 4, 5]
        let std = stddev(data)
        assertTrue(std > 1.4 and std < 1.5)
    })
    
    test("variance calculation", fn() {
        let data = [1, 2, 3, 4, 5]
        let var = variance(data)
        assertEqual(var, 2.0)
    })
    
    test("single value stddev", fn() {
        let data = [5]
        let std = stddev(data)
        assertEqual(std, 0.0)
    })
})

describe("Correlation", fn() {
    test("positive correlation", fn() {
        let x = [1, 2, 3, 4, 5]
        let y = [2, 4, 6, 8, 10]
        let corr = correlation(x, y)
        assertTrue(corr > 0.9)
    })
    
    test("negative correlation", fn() {
        let x = [1, 2, 3, 4, 5]
        let y = [10, 8, 6, 4, 2]
        let corr = correlation(x, y)
        assertTrue(corr < -0.9)
    })
    
    test("no correlation", fn() {
        let x = [1, 2, 3, 4, 5]
        let y = [1, 3, 2, 5, 4]
        let corr = correlation(x, y)
        assertTrue(corr >= -1 and corr <= 1)
    })
    
    test("covariance", fn() {
        let x = [1, 2, 3]
        let y = [2, 4, 6]
        let cov = covariance(x, y)
        assertTrue(cov > 0)
    })
})

describe("Linear Regression", fn() {
    test("fit and predict", fn() {
        let reg = LinearRegression()
        let x = [1, 2, 3, 4, 5]
        let y = [2, 4, 6, 8, 10]
        
        reg.fit(x, y)
        let pred = reg.predict(3)
        assertEqual(pred, 6.0)
    })
    
    test("perfect fit R squared", fn() {
        let reg = LinearRegression()
        let x = [1, 2, 3, 4, 5]
        let y = [2, 4, 6, 8, 10]
        
        reg.fit(x, y)
        let r2 = reg.rSquared()
        assertEqual(r2, 1.0)
    })
    
    test("single point", fn() {
        let reg = LinearRegression()
        let x = [5]
        let y = [10]
        
        reg.fit(x, y)
        assertTrue(true)  # Should not crash
    })
    
    test("predict outside range", fn() {
        let reg = LinearRegression()
        let x = [1, 2, 3]
        let y = [2, 4, 6]
        
        reg.fit(x, y)
        let pred = reg.predict(100)
        assertTrue(pred > 10)
    })
})

describe("K-Means", fn() {
    test("basic clustering", fn() {
        let kmeans = KMeans(2)
        let data = [[1, 1], [2, 2], [10, 10], [11, 11]]
        
        kmeans.fit(data, 10)
        let c1 = kmeans.predict([1.5, 1.5])
        let c2 = kmeans.predict([10.5, 10.5])
        
        # Different clusters for clearly separated points
        assertTrue(true)
    })
    
    test("single cluster", fn() {
        let kmeans = KMeans(1)
        let data = [[1, 1], [2, 2], [3, 3]]
        
        kmeans.fit(data, 5)
        assertTrue(true)
    })
})

describe("Naive Bayes", fn() {
    test("training", fn() {
        let nb = NaiveBayes()
        let data = [
            {text: "good great excellent", label: "positive"},
            {text: "bad awful terrible", label: "negative"}
        ]
        
        nb.train(data)
        assertTrue(true)
    })
    
    test("prediction", fn() {
        let nb = NaiveBayes()
        let data = [
            {text: "great excellent", label: "positive"},
            {text: "terrible bad", label: "negative"}
        ]
        
        nb.train(data)
        let pred = nb.predict("great movie")
        assertTrue(pred != null)
    })
})

describe("Model Evaluation", fn() {
    test("accuracy", fn() {
        let yTrue = [1, 0, 1, 0]
        let yPred = [1, 0, 1, 0]
        let acc = accuracy(yTrue, yPred)
        assertEqual(acc, 1.0)
    })
    
    test("accuracy with errors", fn() {
        let yTrue = [1, 0, 1, 0]
        let yPred = [1, 0, 0, 0]
        let acc = accuracy(yTrue, yPred)
        assertEqual(acc, 0.75)
    })
    
    test("precision", fn() {
        let yTrue = [1, 1, 0, 0]
        let yPred = [1, 1, 0, 0]
        let prec = precision(yTrue, yPred)
        assertEqual(prec, 1.0)
    })
    
    test("recall", fn() {
        let yTrue = [1, 1, 0, 0]
        let yPred = [1, 1, 0, 0]
        let rec = recall(yTrue, yPred)
        assertEqual(rec, 1.0)
    })
    
    test("f1 score", fn() {
        let yTrue = [1, 0, 1, 0]
        let yPred = [1, 0, 1, 0]
        let f1 = f1Score(yTrue, yPred)
        assertEqual(f1, 1.0)
    })
})

describe("Feature Scaling", fn() {
    test("normalization", fn() {
        let data = [10, 20, 30]
        let normalized = normalize(data)
        
        assertTrue(min(normalized) >= 0)
        assertTrue(max(normalized) <= 1)
    })
    
    test("standardization", fn() {
        let data = [1, 2, 3, 4, 5]
        let standardized = standardize(data)
        
        let m = mean(standardized)
        assertTrue(m < 0.01 and m > -0.01)  # Close to 0
    })
})

describe("Edge cases", fn() {
    test("single value array", fn() {
        let data = [42]
        let m = mean(data)
        assertEqual(m, 42.0)
    })
    
    test("two values", fn() {
        let data = [10, 20]
        let m = mean(data)
        assertEqual(m, 15.0)
    })
    
    test("negative values", fn() {
        let data = [-5, -3, -1, 0, 1, 3, 5]
        let m = mean(data)
        assertEqual(m, 0.0)
    })
    
    test("zero in data", fn() {
        let data = [0, 0, 0, 0]
        let m = mean(data)
        assertEqual(m, 0.0)
    })
    
    test("large numbers", fn() {
        let data = [1000000, 2000000, 3000000]
        let m = mean(data)
        assertEqual(m, 2000000.0)
    })
})

output("ML test suite completed")
